# Copy to .env and fill in. Never commit the real .env file.

# CollegeFootballData.com API key (https://collegefootballdata.com/key)
CFBD_API_KEY=

# Kalshi API (read-only market discovery works unauthenticated for most
# endpoints; these are only required once order placement is built, which
# is explicitly out of scope for this foundation phase).
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Visual Crossing Timeline Weather API key (historical game-day weather)
VISUAL_CROSSING_API_KEY=

# Contact string required by NWS/NOAA api.weather.gov as a descriptive User-Agent
NWS_USER_AGENT_CONTACT=you@example.com
